# Desenvolvimento local. Vazio usa PostgreSQL embutido em .data.
DATABASE_URL=
# Juntas habilitam Supabase Auth. Configure também DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origem canônica, sem barra final. Necessária para confirmação de e-mail e Stripe.
SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Usuário administrativo de desenvolvimento. Escolha uma senha de pelo menos 12 caracteres.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# Habilita pagamento de teste somente no banco embutido.
LOCAL_TEST_CHECKOUT=0
# Habilita telemetria agregada. Consulte o README antes de ativar.
NEXT_PUBLIC_ANALYTICS=0
